#include "L3_FSMevent.h"
#include "L3_msg.h"
#include "L3_timer.h"
#include "L3_LLinterface.h"
#include "protocol_parameters.h"
#include "mbed.h"


//FSM state -------------------------------------------------
#define L3STATE_IDLE                0
#define L3STATE_ATTEND              1
#define L3STATE_CHAT                2
#define L3STATE_LEAVE               3


//state variables
static uint8_t main_state = L3STATE_IDLE; //protocol state
static uint8_t prev_state = main_state;

//SDU (input)
static uint8_t originalWord[1030];
static uint8_t wordLen = 0;

static uint8_t sdu[1030];

//serial port interface
static Serial pc(USBTX, USBRX);
static uint8_t myDestId;

//application event handler : generating SDU from keyboard input
static void L3service_processInputWord(void)
{
    char c = pc.getc();
    if (!L3_event_checkEventFlag(L3_event_dataToSend))
    {
        if (c == '\n' || c == '\r')
        {
            originalWord[wordLen++] = '\0';
            L3_event_setEventFlag(L3_event_dataToSend);
            debug_if(DBGMSG_L3, "word is ready! ::: %s\n", originalWord);
        }
        else
        {
            originalWord[wordLen++] = c;
            if (wordLen >= L3_MAXDATASIZE - 1)
            {
                originalWord[wordLen++] = '\0';
                L3_event_setEventFlag(L3_event_dataToSend);
                pc.printf("\n max reached! word forced to be ready :::: %s\n", originalWord);
            }
        }
    }
}


void L3_initFSM(uint8_t destId)
{
    myDestId = destId;
    //initialize service layer
    pc.attach(&L3service_processInputWord, Serial::RxIrq);

    pc.printf("[IDLE] 위치 정보를 입력하세요 : ");
}

void L3_FSMrun(void)
{
    if (prev_state != main_state)
    {
        debug_if(DBGMSG_L3, "[L3] State transition from %i to %i\n", prev_state, main_state);
        prev_state = main_state;
    }

    switch (main_state)
    {
        // =====================================================
        case L3STATE_IDLE:
        // 학생 대기 상태
        // - dataToSend  : 위치 정보 송신
        // - msgRcvd     : "APPROVE" 수신 시 → ATTEND
        // =====================================================
            if (L3_event_checkEventFlag(L3_event_msgRcvd))
            {
                uint8_t* dataPtr = L3_LLI_getMsgPtr();
                uint8_t  size    = L3_LLI_getSize();

                debug_if(DBGMSG_L3, "\n[L3][IDLE] RCVD : %s (length:%i)\n", dataPtr, size);

                if (strncmp((char*)dataPtr, "APPROVE", 7) == 0)
                {
                    pc.printf("[IDLE] 승인 수신 -> ATTEND 상태로 이동\n");
                    pc.printf("[ATTEND] 채팅 요청 메시지를 입력하세요 : ");
                    main_state = L3STATE_ATTEND;
                }
                else
                {
                    // 승인이 아닌 다른 메시지는 출력 후 대기 유지
                    pc.printf("[IDLE] 수신 : %s\n", dataPtr);
                    pc.printf("[IDLE] 위치 정보를 입력하세요 : ");
                }

                L3_event_clearEventFlag(L3_event_msgRcvd);
            }
            else if (L3_event_checkEventFlag(L3_event_dataToSend))
            {
                // 위치 정보 송신
                strcpy((char*)sdu, (char*)originalWord);
                debug_if(DBGMSG_L3, "[L3][IDLE] sending location : %s (len:%i)\n", sdu, wordLen);
                L3_LLI_dataReqFunc(sdu, wordLen, myDestId);

                pc.printf("[IDLE] 위치 정보 전송 완료. 승인 대기 중...\n");
                wordLen = 0;

                L3_event_clearEventFlag(L3_event_dataToSend);
            }
            break;

        // =====================================================
        case L3STATE_ATTEND:
        // 출석 확인 상태
        // - dataToSend  : 채팅 요청 전송
        // - msgRcvd     : "SAME_CLASS" 수신 시 → CHAT
        //                 "LEAVE"      수신 시 → LEAVE
        // =====================================================
            if (L3_event_checkEventFlag(L3_event_msgRcvd))
            {
                uint8_t* dataPtr = L3_LLI_getMsgPtr();
                uint8_t  size    = L3_LLI_getSize();

                debug_if(DBGMSG_L3, "\n[L3][ATTEND] RCVD : %s (length:%i)\n", dataPtr, size);

                if (strncmp((char*)dataPtr, "SAME_CLASS", 10) == 0)
                {
                    pc.printf("[ATTEND] 동일 반 확인 -> CHAT 상태로 이동\n");
                    pc.printf("[CHAT] 메시지를 입력하세요 (종료하려면 'LEAVE' 입력) : ");
                    main_state = L3STATE_CHAT;
                }
                else if (strncmp((char*)dataPtr, "LEAVE", 5) == 0)
                {
                    pc.printf("[ATTEND] 이탈 신호 수신 -> LEAVE 상태로 이동\n");
                    main_state = L3STATE_LEAVE;
                }
                else
                {
                    pc.printf("[ATTEND] 수신 : %s\n", dataPtr);
                    pc.printf("[ATTEND] 채팅 요청 메시지를 입력하세요 : ");
                }

                L3_event_clearEventFlag(L3_event_msgRcvd);
            }
            else if (L3_event_checkEventFlag(L3_event_dataToSend))
            {
                // 채팅 요청 전송
                strcpy((char*)sdu, (char*)originalWord);
                debug_if(DBGMSG_L3, "[L3][ATTEND] sending chat request : %s (len:%i)\n", sdu, wordLen);
                L3_LLI_dataReqFunc(sdu, wordLen, myDestId);

                pc.printf("[ATTEND] 채팅 요청 전송 완료. 동일 반 확인 대기 중...\n");
                wordLen = 0;

                L3_event_clearEventFlag(L3_event_dataToSend);
            }
            break;

        // =====================================================
        case L3STATE_CHAT:
        // 채팅 상태
        // - msgRcvd     : 수신 메시지 출력
        // - dataToSend  : 메시지 전송
        //                 "LEAVE" 입력 시 → LEAVE
        // =====================================================
            if (L3_event_checkEventFlag(L3_event_msgRcvd))
            {
                uint8_t* dataPtr = L3_LLI_getMsgPtr();
                uint8_t  size    = L3_LLI_getSize();

                debug_if(DBGMSG_L3, "\n[L3][CHAT] RCVD : %s (length:%i)\n", dataPtr, size);
                pc.printf("\n[CHAT] 수신 (%d bytes) : %s\n", size, dataPtr);
                pc.printf("[CHAT] 메시지를 입력하세요 : ");

                L3_event_clearEventFlag(L3_event_msgRcvd);
            }
            else if (L3_event_checkEventFlag(L3_event_dataToSend))
            {
                if (strcmp((char*)originalWord, "LEAVE") == 0)
                {
                    // 이탈 요청
                    pc.printf("[CHAT] LEAVE 입력 -> LEAVE 상태로 이동\n");
                    wordLen = 0;
                    L3_event_clearEventFlag(L3_event_dataToSend);
                    main_state = L3STATE_LEAVE;
                }
                else
                {
                    // 일반 채팅 메시지 전송
                    strcpy((char*)sdu, (char*)originalWord);
                    debug_if(DBGMSG_L3, "[L3][CHAT] sending : %s (len:%i)\n", sdu, wordLen);
                    L3_LLI_dataReqFunc(sdu, wordLen, myDestId);

                    pc.printf("[CHAT] 전송 완료.\n");
                    pc.printf("[CHAT] 메시지를 입력하세요 (종료하려면 'LEAVE' 입력) : ");
                    wordLen = 0;

                    L3_event_clearEventFlag(L3_event_dataToSend);
                }
            }
            break;

        // =====================================================
        case L3STATE_LEAVE:
        // 이탈 상태
        // - 진입 즉시 위치 정보 송신 후 IDLE 복귀
        // =====================================================
        {
            strcpy((char*)sdu, "LEAVE");
            uint8_t leaveLen = strlen((char*)sdu) + 1;
            L3_LLI_dataReqFunc(sdu, leaveLen, myDestId);

            debug_if(DBGMSG_L3, "[L3][LEAVE] leave location sent\n");
            pc.printf("[LEAVE] 이탈 위치 정보 전송 완료. IDLE로 복귀\n");
            pc.printf("[IDLE] 위치 정보를 입력하세요 : ");

            L3_event_clearAllEventFlag();
            wordLen = 0;
            main_state = L3STATE_IDLE;
            break;
        }

        default:
            break;
    }
}
